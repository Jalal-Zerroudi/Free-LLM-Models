# Copiez ce fichier vers .env, puis renseignez vos propres cles API.
# NE JAMAIS partager ni publier .env.
GROQ_HOST=https://api.groq.com/openai/v1
GEMINI_HOST=https://generativelanguage.googleapis.com/v1beta
CEREBRAS_HOST=https://api.cerebras.ai/v1
SAMBANOVA_HOST=https://api.sambanova.ai/v1
MISTRAL_HOST=https://api.mistral.ai/v1
COHERE_HOST=https://api.cohere.ai/v2
OPENROUTER_HOST=https://openrouter.ai/api/v1
OLLAMA_HOST=https://ollama.com

GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=

# API REST locale (api.py)
# Chemin de la base SQLite (vide = results/models.db).
LLM_DB_PATH=
# Ordre de classement pour /top et /chat/auto : free, intelligence, coding, latency.
MODEL_RANKING=free,intelligence,latency
CHAT_AUTO_MAX_ATTEMPTS=3
CHAT_MAX_TOKENS=1024
# Nombre maximum de messages précédents envoyés au modèle (onglet Chat, champ history).
CHAT_HISTORY_MAX=20
